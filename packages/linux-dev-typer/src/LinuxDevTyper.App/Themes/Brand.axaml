<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <Color x:Key="Bg">#0A0C12</Color>
    <Color x:Key="Surface">#121622</Color>
    <Color x:Key="Surface2">#171C2A</Color>

    <Color x:Key="Text">#E6EBF5</Color>
    <Color x:Key="Muted">#B7C0D6</Color>

    <Color x:Key="Accent1">#4ADEC8</Color>
    <Color x:Key="Accent2">#7DA8FF</Color>
    <Color x:Key="Warn">#FFD45A</Color>
    <Color x:Key="Error">#FF6B6B</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource Bg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource Surface}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{DynamicResource Surface2}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource Text}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource Muted}" />
    <SolidColorBrush x:Key="Accent1Brush" Color="{DynamicResource Accent1}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{DynamicResource Accent2}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource Warn}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource Error}" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <!-- Focus styles: visible outline for keyboard navigation -->
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style Selector="TextBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style Selector="ComboBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style Selector="CheckBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style Selector="Slider:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

</Styles>
