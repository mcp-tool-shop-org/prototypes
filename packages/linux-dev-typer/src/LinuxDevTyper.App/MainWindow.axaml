<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LinuxDevTyper.App.ViewModels"
        x:Class="LinuxDevTyper.App.MainWindow"
        Width="1200" Height="760"
        Title="linux-dev-typer">
  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Window.KeyBindings>
    <!-- Debug inspector toggle (Ctrl+Shift+D) -->
    <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding ToggleDebugInspectorCommand}"/>
  </Window.KeyBindings>

  <Grid RowDefinitions="56,*">
    <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}">
      <Grid ColumnDefinitions="*,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="linux-dev-typer" FontSize="18" FontWeight="SemiBold"/>
          <Border Background="{DynamicResource Accent2Brush}" CornerRadius="999" Padding="10,3" Margin="10,0,0,0">
            <TextBlock Text="{Binding LevelBadge}" Foreground="Black" FontWeight="SemiBold"/>
          </Border>
          <ComboBox Width="180" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Content="Random" Command="{Binding ShuffleAmbientCommand}" Padding="8,4"/>
          <Button Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}" Padding="8,4"/>
          <Button Content="⚙" Command="{Binding ToggleSidebarCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16">
      <Grid RowDefinitions="Auto,Auto,3*,2*" ColumnDefinitions="2*,*" Margin="0,0,16,0">
        <!-- Welcome back banner -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Surface2Brush}" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,8" IsVisible="{Binding ShowWelcomeBack}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding WelcomeBackText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✕" Command="{Binding DismissWelcomeBackCommand}"
                    Padding="6,2" FontSize="11"/>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
          <Button Content="New Test" Command="{Binding NewTestCommand}"/>
          <Button Content="Reset" Command="{Binding ResetCommand}"/>
          <TextBlock Text="{Binding SessionStatus}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="8,2" Margin="6,0,0,0">
            <TextBlock Text="{Binding DifficultyInfoText}" FontFamily="Monospace" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
          </Border>
          <Button Content="Override" Command="{Binding DismissYoYoLockCommand}" Padding="6,2" FontSize="11"
                  IsVisible="{Binding ShowYoYoOverride}" Margin="4,0,0,0"/>
          <Button Content="History" Command="{Binding ToggleSessionBrowserCommand}" Padding="8,4" Margin="6,0,0,0"/>
          <!-- Orientation cue: subtle, content-only, disappears on first keystroke -->
          <TextBlock Text="{Binding OrientationCue}" Foreground="{DynamicResource MutedBrush}"
                     FontSize="11" Opacity="0.6" Focusable="False" VerticalAlignment="Center" Margin="12,0,0,0"
                     IsVisible="{Binding ShowOrientationCue}"/>
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="14" Margin="0,12,12,12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ScrollViewer x:Name="PromptScroller">
              <TextBlock x:Name="PromptBlock" FontFamily="Monospace" FontSize="{Binding CodeFontSize}" TextWrapping="Wrap"/>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Live Stats (hidden when session browser is open) -->
        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="14" Margin="0,12,0,12"
                IsVisible="{Binding !ShowSessionBrowser}">
          <StackPanel Spacing="10">
            <TextBlock Text="Live Stats" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LiveWpmText}" FontFamily="Monospace"/>
            <TextBlock Text="{Binding LiveAccuracyText}" FontFamily="Monospace"/>
            <TextBlock Text="{Binding ErrorsText}" FontFamily="Monospace"/>
            <TextBlock Text="{Binding XpText}" FontFamily="Monospace"/>
            <Separator Margin="0,6"/>
            <TextBlock Text="Trends" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                       IsVisible="{Binding HasTrendData}"/>
            <TextBlock Text="{Binding TrendWpmText}" FontFamily="Monospace" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding HasTrendData}"/>
            <TextBlock Text="{Binding TrendAccuracyText}" FontFamily="Monospace" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding HasTrendData}"/>
            <Separator Margin="0,6"/>
            <TextBlock Text="Recent" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
            <ItemsControl ItemsSource="{Binding RecentHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <!-- Session Browser (replaces Live Stats when active) -->
        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="14" Margin="0,12,0,12"
                IsVisible="{Binding ShowSessionBrowser}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Session History" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryStatsText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding BrowserStatusText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <TextBox DockPanel.Dock="Top" Text="{Binding SessionFilterText}" Watermark="Filter..." Margin="0,0,0,8"/>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding BrowsableResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Typing input (hidden during completion) -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="14"
                IsVisible="{Binding !ShowCompletion}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Type here (exact match)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            <TextBox x:Name="TypingBox"
                     Text="{Binding TypedText}"
                     AcceptsReturn="True"
                     FontFamily="Monospace"
                     FontSize="{Binding CodeFontSize}"
                     MinHeight="80"
                     KeyDown="TypingBox_KeyDown"/>
          </DockPanel>
        </Border>

        <!-- Completion card (shown after finishing) -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="20"
                IsVisible="{Binding ShowCompletion}">
          <StackPanel Spacing="12">
            <!-- Always visible: core stats + profile badge -->
            <StackPanel Orientation="Horizontal" Spacing="24">
              <TextBlock Text="{Binding CompletionWpm}" FontFamily="Monospace" FontSize="16"/>
              <TextBlock Text="{Binding CompletionAccuracy}" FontFamily="Monospace" FontSize="16"/>
              <TextBlock Text="{Binding CompletionErrors}" FontFamily="Monospace" FontSize="16" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock Text="{Binding CompletionXp}" FontFamily="Monospace" FontSize="16" Foreground="{DynamicResource Accent1Brush}"/>
              <TextBlock Text="{Binding ActiveProfileBadge}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center" IsVisible="{Binding IsEditableProfile}"/>
            </StackPanel>
            <!-- Fatigue banner (always visible when active) -->
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12"
                    IsVisible="{Binding ShowFatigue}" Margin="0,4,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding FatigueText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Command="{Binding DismissFatigueCommand}"
                        Padding="6,2" FontSize="11" VerticalAlignment="Top"/>
              </Grid>
            </Border>
            <!-- Details toggle -->
            <Button Content="Details" Command="{Binding ToggleCompletionDetailsCommand}"
                    Padding="8,3" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left"/>
            <!-- Details section (behind toggle) -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowCompletionDetails}">
              <Separator/>
              <TextBlock Text="What you learned:" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
              <ItemsControl ItemsSource="{Binding ExplainBullets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <TextBlock Text="*" Foreground="{DynamicResource Accent2Brush}"/>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Community notes: tips & perspectives from shared packs -->
              <TextBlock Text="Tips &amp; perspectives" FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}"
                         IsVisible="{Binding HasNotes}" Margin="0,8,0,0"/>
              <ItemsControl ItemsSource="{Binding NotesBullets}" IsVisible="{Binding HasNotes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <TextBlock Text="~" Foreground="{DynamicResource MutedBrush}"/>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Scaffold: progressive learning context.
                   Calm teaching: "Context" (not "Lesson"), "More context" (not "Learn more"),
                   "Other approaches" (not "Better ways"). No urgency, no comparison. -->
              <TextBlock Text="Context" FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}"
                         IsVisible="{Binding HasScaffold}" Margin="0,8,0,0"/>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2"
                          IsVisible="{Binding HasScaffold}">
                <TextBlock Text="^" Foreground="{DynamicResource Accent2Brush}"/>
                <TextBlock Text="{Binding ScaffoldHint}" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Content="More context" Command="{Binding ToggleScaffoldDepthCommand}"
                      Padding="8,3" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                      HorizontalAlignment="Left" IsVisible="{Binding HasScaffoldDepth}" Margin="0,4,0,0"
                      AutomationProperties.Name="Toggle deeper scaffold context"/>
              <ItemsControl ItemsSource="{Binding ScaffoldDepth}"
                            IsVisible="{Binding ScaffoldExpanded}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <TextBlock Text="^" Foreground="{DynamicResource MutedBrush}"/>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Variants: alternative implementations -->
              <TextBlock Text="Other approaches" FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}"
                         IsVisible="{Binding HasVariants}" Margin="0,8,0,0"/>
              <ItemsControl ItemsSource="{Binding VariantBullets}" IsVisible="{Binding HasVariants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6"
                            Padding="10,6" Margin="0,4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="=" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Selection explanation: why this snippet was chosen -->
              <TextBlock Text="Why this snippet" FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}"
                         IsVisible="{Binding HasSelectionFactors}" Margin="0,8,0,0"
                         AutomationProperties.Name="Selection explanation header"/>
              <TextBlock Text="{Binding SelectionReasonText}"
                         Foreground="{DynamicResource MutedBrush}" FontSize="11"
                         IsVisible="{Binding HasSelectionFactors}" Margin="0,2,0,0"
                         AutomationProperties.Name="Selection reason"/>
              <ItemsControl ItemsSource="{Binding SelectionFactors}"
                            IsVisible="{Binding HasSelectionFactors}"
                            AutomationProperties.Name="Selection factors list">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <TextBlock Text="+" Foreground="{DynamicResource MutedBrush}" Opacity="0.6"/>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding SessionWeakSpots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <TextBlock Text="!" Foreground="{DynamicResource Accent1Brush}" FontWeight="Bold"/>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Per-character weakness trajectory -->
              <TextBlock Text="{Binding WeaknessTrajectorySummary}"
                         Foreground="{DynamicResource MutedBrush}" FontSize="11" FontStyle="Italic"
                         IsVisible="{Binding HasWeaknessTrajectory}" Margin="0,4,0,0"
                         AutomationProperties.Name="Weakness trajectory summary"/>
              <ItemsControl ItemsSource="{Binding WeaknessTrajectoryItems}"
                            IsVisible="{Binding HasWeaknessTrajectory}"
                            AutomationProperties.Name="Weakness trajectory items">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="10"
                               Foreground="{DynamicResource MutedBrush}" Opacity="0.8" Margin="0,1"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding CompletionTrendSummary}" Foreground="{DynamicResource MutedBrush}"
                         FontFamily="Monospace" FontSize="11" IsVisible="{Binding HasTrendData}" Margin="0,4,0,0"/>
              <!-- Insights -->
              <ItemsControl ItemsSource="{Binding InsightItems}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <TextBlock Text="*" Foreground="{DynamicResource Accent2Brush}"/>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                      <Button Content="✕" CommandParameter="{Binding Type}"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DismissInsightCommand}"
                              Padding="4,1" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Community difficulty (display-only signal) -->
              <TextBlock Text="{Binding CommunityDifficultyText}"
                         Foreground="{DynamicResource MutedBrush}"
                         FontFamily="Monospace" FontSize="11"
                         IsVisible="{Binding ShowCommunityDifficulty}" Margin="0,4,0,0"/>
              <!-- Group stats -->
              <TextBlock Text="{Binding GroupStatsText}" Foreground="{DynamicResource MutedBrush}"
                         FontFamily="Monospace" FontSize="11" IsVisible="{Binding ShowGroupStats}" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- Default suggestions banner -->
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10"
                    IsVisible="{Binding ShowDefaultSuggestions}" Margin="0,4,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding DefaultSuggestions}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Apply" Command="{Binding ApplyDefaultSuggestionsCommand}" Padding="8,3" FontSize="11"/>
                  <Button Content="Dismiss" Command="{Binding DismissDefaultSuggestionsCommand}" Padding="8,3" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- Session note -->
            <TextBox Text="{Binding SessionNote}" Watermark="Add a note (optional)" MaxLength="200"
                     FontSize="12" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="Next" Command="{Binding NextCommand}"/>
              <Button Content="Repeat" Command="{Binding RepeatCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Column="1" Width="{Binding SidebarWidth}" Background="{DynamicResource Surface2Brush}" Padding="14">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"/>
            <CheckBox Content="Hardcore Mode" IsChecked="{Binding HardcoreMode}"/>
            <TextBlock Text="Fix each mistake before advancing" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="24,-8,0,0"/>
            <CheckBox Content="Reduced sensory" IsChecked="{Binding ReducedSensory}"/>
            <TextBlock Text="Font size" Foreground="{DynamicResource MutedBrush}"/>
            <Slider Minimum="12" Maximum="24" Value="{Binding CodeFontSize}"/>

            <Separator/>
            <TextBlock Text="Audio" FontSize="14" FontWeight="SemiBold"/>

            <TextBlock Text="Keyboard sound" Foreground="{DynamicResource MutedBrush}"/>
            <ComboBox Width="260"
                      ItemsSource="{Binding KeyboardThemes}"
                      SelectedItem="{Binding SelectedKeyboardTheme}"/>

            <TextBlock Text="Key volume" Foreground="{DynamicResource MutedBrush}"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding KeyVolume}"
                    SmallChange="0.05" LargeChange="0.1"/>

            <TextBlock Text="Ambient volume" Foreground="{DynamicResource MutedBrush}"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding AmbientVolume}"
                    SmallChange="0.05" LargeChange="0.1"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Random" Command="{Binding ShuffleAmbientCommand}"/>
              <CheckBox Content="Mute ambient" IsChecked="{Binding AmbientMuted}"/>
            </StackPanel>

            <TextBlock Text="UI sound volume" Foreground="{DynamicResource MutedBrush}"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding UiVolume}"
                    SmallChange="0.05" LargeChange="0.1"/>

            <Separator/>
            <Button Content="Save Settings" Command="{Binding SaveCommand}"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Weaknesses" FontSize="14" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding OverallWeaknesses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No data yet" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       IsVisible="{Binding HasNoWeaknesses}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="Focus Practice" Command="{Binding FocusPracticeCommand}" Padding="8,4"
                      IsVisible="{Binding !HasNoWeaknesses}"
                      AutomationProperties.Name="Start focus practice on top weakness"/>
              <Button Content="Micro-drill" Command="{Binding StartMicroDrillCommand}" Padding="8,4"
                      IsVisible="{Binding !HasNoWeaknesses}"
                      AutomationProperties.Name="Start 5-item micro-drill on top weakness"/>
              <Button Content="Clear Focus" Command="{Binding ClearFocusCommand}" Padding="8,4"
                      IsVisible="{Binding IsFocusMode}"
                      AutomationProperties.Name="Clear focus practice mode"/>
            </StackPanel>
            <TextBlock Text="{Binding DrillProgressText}" FontSize="11"
                       Foreground="{DynamicResource Accent2Brush}"
                       IsVisible="{Binding IsDrillMode}" Margin="0,2,0,0"
                       AutomationProperties.Name="Micro-drill progress"/>

            <TextBlock Text="{Binding SkillSummaryText}" Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" FontStyle="Italic" Margin="0,6,0,0"
                       IsVisible="{Binding HasRollingWeaknesses}"
                       AutomationProperties.Name="Skill summary"/>
            <ItemsControl ItemsSource="{Binding RollingWeaknesses}"
                          IsVisible="{Binding HasRollingWeaknesses}"
                          AutomationProperties.Name="Rolling weakness scores">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="10"
                             Foreground="{DynamicResource MutedBrush}" Opacity="0.8" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Per-character" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}"
                       IsVisible="{Binding HasCharWeaknesses}" Margin="0,6,0,0"
                       AutomationProperties.Name="Per-character weaknesses"/>
            <ItemsControl ItemsSource="{Binding CharWeaknesses}"
                          IsVisible="{Binding HasCharWeaknesses}"
                          AutomationProperties.Name="Character weakness list">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="10"
                             Foreground="{DynamicResource MutedBrush}" Opacity="0.8" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,6"/>
            <TextBlock Text="Difficulty" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ComfortZoneText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            <TextBlock Text="{Binding DifficultyInfoText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            <TextBlock Text="{Binding PlanReasonText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Opacity="0.7"/>
            <CheckBox Content="Lock difficulty" IsChecked="{Binding IsDifficultyLocked}"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Performance" FontSize="14" FontWeight="SemiBold"/>
            <CheckBox Content="Show performance cues" IsChecked="{Binding ShowPerformanceCues}"/>
            <TextBlock Text="Declining trends, sloppy warnings, fatigue" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="24,-8,0,0"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Personalization" FontSize="14" FontWeight="SemiBold"/>
            <CheckBox Content="Freeze personalization" IsChecked="{Binding FreezePersonalization}"/>
            <TextBlock Text="Stop learning new preferences" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="24,-8,0,0"/>
            <Button Content="Reset learned preferences" Command="{Binding ResetPersonalizationCommand}" Padding="8,4" FontSize="11" Margin="0,4,0,0"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Community" FontSize="14" FontWeight="SemiBold"/>
            <CheckBox Content="Show community notes" IsChecked="{Binding ShowCommunityNotes}"
                      AutomationProperties.Name="Show community notes"/>
            <TextBlock Text="Tips and perspectives from shared packs"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="24,-8,0,0"/>
            <CheckBox Content="Show community signals" IsChecked="{Binding ShowCommunitySignals}"
                      AutomationProperties.Name="Show community signals"/>
            <TextBlock Text="Community difficulty observations"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="24,-8,0,0"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Teaching" FontSize="14" FontWeight="SemiBold"/>
            <CheckBox Content="Show scaffolds" IsChecked="{Binding ShowScaffolds}"
                      AutomationProperties.Name="Show learning scaffolds"/>
            <TextBlock Text="Progressive context for each snippet"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="24,-8,0,0"/>
            <CheckBox Content="Show variants" IsChecked="{Binding ShowVariants}"
                      AutomationProperties.Name="Show alternative implementations"/>
            <TextBlock Text="Other valid approaches to the same problem"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="24,-8,0,0"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Guided Mode" FontSize="14" FontWeight="SemiBold"/>
            <CheckBox Content="Enable guided practice" IsChecked="{Binding GuidedMode}"
                      AutomationProperties.Name="Enable guided practice mode"/>
            <TextBlock Text="Prefers snippets matching your weak spots"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="24,-8,0,0"/>
            <TextBlock Text="Off = v0.9 behavior (no signal influence)"
                       Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="24,0,0,0"/>
            <TextBlock Text="Practice a few sessions first to build weakness data"
                       Foreground="{DynamicResource MutedBrush}" FontSize="10"
                       FontStyle="Italic" Margin="24,2,0,0"
                       IsVisible="{Binding HasNoWeaknesses}"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Practice Profiles" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="Active profile:" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            <ComboBox Width="260" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"
                      AutomationProperties.Name="Active practice profile"/>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
              <TextBox Width="160" Text="{Binding NewProfileName}" Watermark="New profile name" FontSize="11"
                       AutomationProperties.Name="New profile name"/>
              <Button Content="Create" Command="{Binding CreateProfileCommand}" Padding="8,3" FontSize="11"
                      AutomationProperties.Name="Create new profile"/>
              <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Padding="8,3" FontSize="11"
                      IsVisible="{Binding IsEditableProfile}" AutomationProperties.Name="Delete selected profile"/>
            </StackPanel>
            <!-- Profile diff from Default -->
            <TextBlock Text="{Binding ProfileDiffSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                       TextWrapping="Wrap" IsVisible="{Binding IsEditableProfile}" Margin="0,2,0,0"/>
            <!-- Profile editor (visible only for non-Default profiles) -->
            <StackPanel Spacing="6" IsVisible="{Binding IsEditableProfile}" Margin="0,6,0,0">
              <TextBlock Text="XP multiplier" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <Slider Minimum="0.1" Maximum="2.0" Value="{Binding ProfileXpMultiplier}" SmallChange="0.1"
                      AutomationProperties.Name="XP multiplier"/>
              <TextBlock Text="Sloppy threshold (%)" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <Slider Minimum="50" Maximum="95" Value="{Binding ProfileSloppyThreshold}" SmallChange="1"
                      AutomationProperties.Name="Sloppy accuracy threshold"/>
              <TextBlock Text="Rating K-factor" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <Slider Minimum="8" Maximum="64" Value="{Binding ProfileRatingKFactor}" SmallChange="4"
                      AutomationProperties.Name="Rating K-factor"/>
              <TextBlock Text="Comfort accuracy (%)" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <Slider Minimum="60" Maximum="98" Value="{Binding ProfileComfortAccuracy}" SmallChange="1"
                      AutomationProperties.Name="Comfort accuracy threshold"/>
              <TextBlock Text="Comfort min sessions" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <Slider Minimum="1" Maximum="10" Value="{Binding ProfileComfortMinSessions}" SmallChange="1"
                      AutomationProperties.Name="Comfort minimum sessions"/>
              <TextBlock Text="Trend WPM threshold" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <Slider Minimum="0.5" Maximum="10" Value="{Binding ProfileTrendWpmThreshold}" SmallChange="0.5"
                      AutomationProperties.Name="Trend WPM threshold"/>
              <TextBlock Text="Fatigue break sessions" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <Slider Minimum="3" Maximum="20" Value="{Binding ProfileFatigueBreakSessions}" SmallChange="1"
                      AutomationProperties.Name="Fatigue break session count"/>
            </StackPanel>

            <Separator Margin="0,6"/>
            <TextBlock Text="Snippet Packs" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PackStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            <ItemsControl ItemsSource="{Binding PackItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding Enabled}" Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Refresh Packs" Command="{Binding RefreshPacksCommand}" Padding="8,4" FontSize="11" Margin="0,4,0,0"
                    AutomationProperties.Name="Refresh user snippet packs"/>
            <TextBlock Text="Drop .json files into packs folder" Foreground="{DynamicResource MutedBrush}" FontSize="10" Opacity="0.6"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Library" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ContentItemCount, StringFormat='{}{0} items indexed'}"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            <TextBlock Text="{Binding LibraryHealthText}" Foreground="{DynamicResource MutedBrush}"
                       FontSize="10" TextWrapping="Wrap"
                       AutomationProperties.Name="Library health diagnostics"/>
            <TextBlock Text="{Binding ContentStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
            <!-- Paste Code -->
            <TextBlock Text="Paste Code" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
            <TextBox Text="{Binding PasteCodeTitle}" Watermark="Title (optional)" FontSize="11"
                     AutomationProperties.Name="Paste code title"/>
            <TextBox Text="{Binding PasteCodeLanguage}" Watermark="Language (auto-detect)" FontSize="11"
                     AutomationProperties.Name="Paste code language hint"/>
            <TextBox Text="{Binding PasteCodeText}" Watermark="Paste code here..." AcceptsReturn="True"
                     MinHeight="60" MaxHeight="120" FontFamily="Monospace" FontSize="11"
                     AutomationProperties.Name="Paste code text"/>
            <Button Content="Add" Command="{Binding PasteCodeCommand}" Padding="8,3" FontSize="11"
                    AutomationProperties.Name="Add pasted code to library"/>
            <!-- Import -->
            <TextBlock Text="Import" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
            <TextBox Text="{Binding ImportFilePath}" Watermark="File path" FontSize="11"
                     AutomationProperties.Name="Import file path"/>
            <Button Content="Import File" Command="{Binding ImportFileCommand}" Padding="8,3" FontSize="11"
                    AutomationProperties.Name="Import file to library"/>
            <TextBox Text="{Binding ImportFolderPath}" Watermark="Folder path" FontSize="11"
                     AutomationProperties.Name="Import folder path"/>
            <Button Content="Import Folder" Command="{Binding ImportFolderCommand}" Padding="8,3" FontSize="11"
                    AutomationProperties.Name="Import folder to library"/>

            <Separator Margin="0,6"/>
            <TextBlock Text="Import / Export" FontSize="14" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Export" Command="{Binding ExportCommand}" Padding="8,4" FontSize="11"
                      AutomationProperties.Name="Export packs and profiles"/>
              <Button Content="Import" Command="{Binding ImportCommand}" Padding="8,4" FontSize="11"
                      AutomationProperties.Name="Import packs and profiles"/>
            </StackPanel>
            <TextBlock Text="{Binding ImportExportStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>

            <!-- Debug Inspector (v0.9.0) — toggled by Ctrl+Shift+D -->
            <Separator Margin="0,6" IsVisible="{Binding DebugInspectorVisible}"/>
            <TextBlock Text="Debug Inspector" FontSize="14" FontWeight="SemiBold"
                       Foreground="Orange" IsVisible="{Binding DebugInspectorVisible}"/>
            <TextBlock Text="{Binding DebugPlanInfo}" FontFamily="Monospace" FontSize="9"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding DebugInspectorVisible}"/>
            <TextBlock Text="{Binding DebugDifficultyInfo}" FontFamily="Monospace" FontSize="9"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding DebugInspectorVisible}"/>
            <TextBlock Text="{Binding DebugWeaknessInfo}" FontFamily="Monospace" FontSize="9"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding DebugInspectorVisible}"/>
            <TextBlock Text="{Binding DebugHeatmapInfo}" FontFamily="Monospace" FontSize="9"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding DebugInspectorVisible}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
