<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>TrainingStudio.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Package metadata -->
		<Description>Training Studio - TensorFlow.js-powered ML bundle validation tool with security-first design and zero code execution. Validates ML bundles with JSON output for CI/CD integration.</Description>
		<Authors>mcp-tool-shop</Authors>
		<Company>MCP Tool Shop</Company>
		<Copyright>Copyright (c) 2025-2026 MCP Tool Shop</Copyright>
		<PackageProjectUrl>https://github.com/mcp-tool-shop-org/training-studio</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mcp-tool-shop-org/training-studio</RepositoryUrl>
		<PackageTags>maui;ml;tensorflow;validation;security</PackageTags>

		<!-- Display name -->
		<ApplicationTitle>Training Studio</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.mcptoolshop.trainingstudio</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Packaging: Use 'None' for dev, remove for Store MSIX builds -->
		<!-- For Store submission, comment out the line below -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Store submission manifest (used when WindowsPackageType is not None) -->
		<AppxManifest Condition="'$(WindowsPackageType)' != 'None'">Package.appxmanifest</AppxManifest>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets - includes the web app -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
	</ItemGroup>

	<!-- Copy web build output to Resources/Raw/wwwroot -->
	<Target Name="CopyWebAssets" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<WebDistFiles Include="..\TrainingStudio.Web\dist\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(WebDistFiles)" DestinationFolder="Resources\Raw\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
