{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codeteam.keyfile.schema.v0.1.json",
  "title": "CodeTeam Key File",
  "description": "JWK-like key file format for Ed25519 keys",
  "type": "object",
  "required": ["kty", "crv", "x", "kid"],
  "properties": {
    "kty": {
      "type": "string",
      "description": "Key type",
      "const": "OKP"
    },
    "crv": {
      "type": "string",
      "description": "Curve",
      "const": "Ed25519"
    },
    "d": {
      "type": "string",
      "description": "Private key (seed) as Base64URL. Required for signing.",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "x": {
      "type": "string",
      "description": "Public key as Base64URL",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "kid": {
      "type": "string",
      "description": "Key ID (first 16 hex chars of SHA256 of public key)",
      "pattern": "^[0-9a-f]{16}$"
    }
  }
}
